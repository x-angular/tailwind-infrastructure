{
  "name": "x-angular",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "lint": "eslint .",
    "lint:commit": "commitlint --edit",
    "lint:fix": "npm run lint -- --fix",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "start": "ng serve",
    "test": "ng test",
    "watch": "ng build --watch --configuration development",
    "x-cli": "bun --tsconfig-override tsconfig.cmd.json cli/index.ts"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@types/prompts": "^2.4.9",
    "angular-eslint": "^22.5.0",
    "commander": "^15.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "prompts": "^2.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
